# SolarSync Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# Environment Mode: development | production | test
ENVIRONMENT=development
PROJECT_NAME="SolarSync"
API_V1_STR="/api/v1"

# Security & Authentication (Generate secure secret in production)
# Example generation: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secure_random_string_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL with PostGIS Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=solarsync_admin
POSTGRES_PASSWORD=solarsync_secret
POSTGRES_DB=solarsync_db
# Connection URL format (Docker Compose service uses postgres:5432)
# For local dev without docker: postgresql://solarsync_admin:solarsync_secret@localhost:5432/solarsync_db
# In Docker compose: postgresql://solarsync_admin:solarsync_secret@postgres:5432/solarsync_db
DATABASE_URL=postgresql://solarsync_admin:solarsync_secret@localhost:5432/solarsync_db

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File Uploads Directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment Variables (Prefix with VITE_ for Vite bundling)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_DEFAULT_LAT=12.9716
VITE_MAP_DEFAULT_LNG=77.5946
VITE_MAP_DEFAULT_ZOOM=12

# Mapbox Integration (Satellite & High-Res Vector Maps)
VITE_MAPBOX_TOKEN=your_mapbox_token_here
